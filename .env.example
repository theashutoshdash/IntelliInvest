# Required in production. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-secret

# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an authorised redirect URI in Google Cloud Console.
GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/auth/google/callback

# Local default is SQLite. For production use PostgreSQL, e.g.
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/intellinvest
DATABASE_URL=sqlite:///intellinvest.db

FLASK_ENV=development
AUTO_CREATE_DB=false
TRUST_PROXY=false
TRUSTED_HOSTS=localhost,127.0.0.1
RISK_FREE_RATE=0.065
